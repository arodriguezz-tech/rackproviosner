@page "/admin/inventory"
@using RackProvisioner.Core
@using RackProvisioner.Domain
@using RackProvisioner.Services
@inject InventoryManagementViewModel ViewModel

<PageTitle>Inventory Management - Admin Console</PageTitle>

<div class="admin-container">
    <div class="admin-header">
        <h1>Inventory Management</h1>
        <p class="subtitle">Add, edit, and delete switches from rack inventory</p>
    </div>

    <div class="admin-controls">
        <button class="btn btn-primary" @onclick="ShowAddRackModal">
            <span class="icon">+</span> Add Rack
        </button>
        <button class="btn btn-secondary" @onclick="RefreshInventory">
            <span class="icon">⟳</span> Refresh
        </button>
    </div>

    @if (ViewModel.IsLoading)
    {
        <div class="loading">Loading inventory...</div>
    }
    else if (!string.IsNullOrEmpty(ViewModel.ErrorMessage))
    {
        <div class="error-message">@ViewModel.ErrorMessage</div>
    }
    else if (ViewModel.Racks.Count == 0)
    {
        <div class="empty-state">
            <p>No racks found. <button class="link-btn" @onclick="ShowAddRackModal">Create one</button></p>
        </div>
    }
    else
    {
        <div class="racks-grid">
            @foreach (var rack in ViewModel.Racks)
            {
                <div class="rack-card">
                    <div class="rack-header">
                        <h3>@rack.Serial</h3>
                        <span class="rack-id">ID: @rack.Id.ToString().Substring(0, 8)...</span>
                    </div>

                    <div class="rack-info">
                        <div class="info-row">
                            <label>Position:</label>
                            <span>@rack.Position</span>
                        </div>
                        <div class="info-row">
                            <label>Created:</label>
                            <span>@rack.CreatedAt.ToString("yyyy-MM-dd")</span>
                        </div>
                        <div class="info-row">
                            <label>Switches:</label>
                            <span>@(rack.Inventory?.Count ?? 0)</span>
                        </div>
                    </div>

                    <div class="switches-list">
                        <h4>Switches in Inventory</h4>
                        @if (rack.Inventory?.Count == 0)
                        {
                            <p class="empty">No switches</p>
                        }
                        else
                        {
                            <ul>
                                @foreach (var sw in rack.Inventory!)
                                {
                                    <li>
                                        <div class="switch-item">
                                            <span class="model">@sw.Model</span>
                                            <span class="version">v@sw.InventoryVersion</span>
                                            <button class="btn-small btn-danger" @onclick="@(() => RemoveSwitch(rack.Id, sw.Id))">
                                                Remove
                                            </button>
                                        </div>
                                    </li>
                                }
                            </ul>
                        }
                    </div>

                    <div class="rack-actions">
                        <button class="btn btn-sm btn-primary" @onclick="@(() => ShowAddSwitchModal(rack.Id))">
                            Add Switch
                        </button>
                        <button class="btn btn-sm btn-danger" @onclick="@(() => DeleteRack(rack.Id))">
                            Delete Rack
                        </button>
                    </div>
                </div>
            }
        </div>
    }
</div>

<!-- Add Rack Modal -->
@if (showAddRackModal)
{
    <div class="modal-overlay" @onclick="CloseAddRackModal">
        <div class="modal" @onclick:stopPropagation>
            <div class="modal-header">
                <h2>Add New Rack</h2>
                <button class="close-btn" @onclick="CloseAddRackModal">&times;</button>
            </div>
            <div class="modal-body">
                <div class="form-group">
                    <label for="serial">Serial Number</label>
                    <input type="text" id="serial" class="form-control" @bind="newRackSerial" placeholder="e.g., RK1617">
                </div>
                <div class="form-group">
                    <label for="position">Rack Position</label>
                    <input type="text" id="position" class="form-control" @bind="newRackPosition" placeholder="e.g., Rack-A-01">
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" @onclick="CloseAddRackModal">Cancel</button>
                <button class="btn btn-primary" @onclick="CreateRack">Create Rack</button>
            </div>
        </div>
    </div>
}

<!-- Add Switch Modal -->
@if (showAddSwitchModal)
{
    <div class="modal-overlay" @onclick="CloseAddSwitchModal">
        <div class="modal" @onclick:stopPropagation>
            <div class="modal-header">
                <h2>Add Switch to Rack</h2>
                <button class="close-btn" @onclick="CloseAddSwitchModal">&times;</button>
            </div>
            <div class="modal-body">
                <div class="form-group">
                    <label for="model">Switch Model</label>
                    <input type="text" id="model" class="form-control" @bind="newSwitchModel" placeholder="e.g., Arista-7050">
                </div>
                <div class="form-group">
                    <label for="version">Inventory Version</label>
                    <input type="text" id="version" class="form-control" @bind="newSwitchVersion" placeholder="e.g., 1.0">
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" @onclick="CloseAddSwitchModal">Cancel</button>
                <button class="btn btn-primary" @onclick="AddSwitch">Add Switch</button>
            </div>
        </div>
    </div>
}

@code {
    private bool showAddRackModal = false;
    private bool showAddSwitchModal = false;
    private string newRackSerial = "";
    private string newRackPosition = "";
    private string newSwitchModel = "";
    private string newSwitchVersion = "";
    private Guid selectedRackId;

    protected override async Task OnInitializedAsync()
    {
        await ViewModel.LoadRacksAsync();
    }

    private async Task RefreshInventory()
    {
        await ViewModel.LoadRacksAsync();
    }

    private void ShowAddRackModal()
    {
        newRackSerial = "";
        newRackPosition = "";
        showAddRackModal = true;
    }

    private void CloseAddRackModal()
    {
        showAddRackModal = false;
    }

    private async Task CreateRack()
    {
        if (string.IsNullOrWhiteSpace(newRackSerial) || string.IsNullOrWhiteSpace(newRackPosition))
        {
            return;
        }

        await ViewModel.CreateRackAsync(newRackSerial, newRackPosition);
        CloseAddRackModal();
    }

    private void ShowAddSwitchModal(Guid rackId)
    {
        selectedRackId = rackId;
        newSwitchModel = "";
        newSwitchVersion = "";
        showAddSwitchModal = true;
    }

    private void CloseAddSwitchModal()
    {
        showAddSwitchModal = false;
    }

    private async Task AddSwitch()
    {
        if (string.IsNullOrWhiteSpace(newSwitchModel) || string.IsNullOrWhiteSpace(newSwitchVersion))
        {
            return;
        }

        if (!int.TryParse(newSwitchVersion, out int ports))
        {
            return;
        }

        await ViewModel.AddSwitchAsync(selectedRackId, newSwitchModel, ports);
        CloseAddSwitchModal();
    }

    private async Task RemoveSwitch(Guid rackId, int switchId)
    {
        await ViewModel.RemoveSwitchAsync(rackId, switchId);
    }

    private async Task DeleteRack(Guid rackId)
    {
        await ViewModel.DeleteRackAsync(rackId);
    }
}

