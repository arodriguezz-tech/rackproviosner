@page "/admin/configuration"
@using RackProvisioner.Core
@using RackProvisioner.Domain
@using RackProvisioner.Services
@inject ConfigurationManagementViewModel ViewModel

<PageTitle>Configuration Management - Admin Console</PageTitle>

<div class="admin-container">
    <div class="admin-header">
        <h1>Configuration Management</h1>
        <p class="subtitle">Create, edit, and manage switch configuration profiles and versions</p>
    </div>

    <div class="admin-controls">
        <button class="btn btn-primary" @onclick="ShowCreateConfigModal">
            <span class="icon">+</span> Create Profile
        </button>
        <button class="btn btn-secondary" @onclick="RefreshConfigurations">
            <span class="icon">⟳</span> Refresh
        </button>
    </div>

    @if (!string.IsNullOrEmpty(ViewModel.ErrorMessage))
    {
        <div class="error-message">
            @ViewModel.ErrorMessage
        </div>
    }

    <div class="tabs">
        <button class="tab @(ViewModel.ActiveTab == "active" ? "active" : "")" @onclick="@(() => SwitchTab("active"))">
            Active Profiles
        </button>
        <button class="tab @(ViewModel.ActiveTab == "archived" ? "active" : "")" @onclick="@(() => SwitchTab("archived"))">
            Archived Profiles
        </button>
        <button class="tab @(ViewModel.ActiveTab == "history" ? "active" : "")" @onclick="@(() => SwitchTab("history"))">
            Version History
        </button>
    </div>

    @if (ViewModel.IsLoading)
    {
        <div class="loading">Loading configurations...</div>
    }
    else if (ViewModel.ActiveTab == "active" || ViewModel.ActiveTab == "archived")
    {
        var displayConfigs = ViewModel.ActiveTab == "active" 
            ? ViewModel.ActiveConfigs
            : ViewModel.ArchivedConfigs;

        @if (displayConfigs.Count == 0)
        {
            <div class="empty-state">
                <p>No @ViewModel.ActiveTab profiles found.</p>
            </div>
        }
        else
        {
            <div class="configs-table">
                <table>
                    <thead>
                        <tr>
                            <th>Profile Name</th>
                            <th>Description</th>
                            <th>Version</th>
                            <th>Last Modified</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var config in displayConfigs)
                        {
                            <tr>
                                <td class="name">@config.Name</td>
                                <td class="description">@config.Description</td>
                                <td class="version">-</td>
                                <td class="modified">@config.UpdatedAt.ToString("MMM dd, yyyy")</td>
                                <td>
                                    @if (!config.IsActive)
                                    {
                                        <span class="badge archived">Archived</span>
                                    }
                                    else
                                    {
                                        <span class="badge active">Active</span>
                                    }
                                </td>
                                <td class="actions">
                                    <button class="btn-action btn-edit" @onclick="@(() => ShowEditConfigModal(config.Id))">
                                        Edit
                                    </button>
                                    @if (config.IsActive)
                                    {
                                        <button class="btn-action btn-archive" @onclick="@(() => ArchiveConfig(config.Id))">
                                            Archive
                                        </button>
                                    }
                                    else
                                    {
                                        <button class="btn-action btn-restore" @onclick="@(() => RestoreConfig(config.Id))">
                                            Restore
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    }
    else if (ViewModel.ActiveTab == "history")
    {
        @if (ViewModel.VersionHistory.Count == 0)
        {
            <div class="empty-state">
                <p>No version history available.</p>
            </div>
        }
        else
        {
            <div class="history-timeline">
                @foreach (var entry in ViewModel.VersionHistory)
                {
                    <div class="history-entry">
                        <div class="history-marker"></div>
                        <div class="history-content">
                            <div class="history-header">
                                <h4>@entry.Name</h4>
                                <span class="timestamp">@entry.CreatedAt.ToString("MMM dd, yyyy HH:mm")</span>
                            </div>
                            <p class="history-description">Configuration ID: @entry.ConfigId</p>
                        </div>
                    </div>
                }
            </div>
        }
    }
</div>

<!-- Create/Edit Config Modal -->
@if (showConfigModal)
{
    <div class="modal-overlay" @onclick="CloseConfigModal">
        <div class="modal" @onclick:stopPropagation>
            <div class="modal-header">
                <h2>@(isEditMode ? "Edit Configuration" : "Create New Configuration")</h2>
                <button class="close-btn" @onclick="CloseConfigModal">&times;</button>
            </div>
            <div class="modal-body">
                @if (!string.IsNullOrEmpty(ViewModel.ErrorMessage))
                {
                    <div class="error-message">
                        @ViewModel.ErrorMessage
                    </div>
                }
                <div class="form-group">
                    <label for="profileName">Profile Name</label>
                    <input type="text" id="profileName" class="form-control" @bind="currentConfig.Name" placeholder="e.g., Production-Switch-Config">
                </div>
                <div class="form-group">
                    <label for="description">Description</label>
                    <textarea id="description" class="form-control textarea" @bind="currentConfig.Description" placeholder="Describe this configuration profile..."></textarea>
                </div>
                <div class="form-group">
                    <label for="configData">Configuration Content</label>
                    <textarea id="configData" class="form-control textarea code" @bind="currentConfig.Content" placeholder="Enter configuration content..."></textarea>
                </div>
                <div class="form-group" style="display: flex; gap: 1rem;">
                    <p style="color: #666; margin: 0;">Use the Active/Archived buttons in the table to manage configuration status.</p>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" @onclick="CloseConfigModal">Cancel</button>
                <button class="btn btn-primary" @onclick="SaveConfig">@(isEditMode ? "Update" : "Create") Profile</button>
            </div>
        </div>
    </div>
}

<!-- View Diff Modal -->
@if (showDiffModal)
{
    <div class="modal-overlay" @onclick="CloseDiffModal">
        <div class="modal modal-large" @onclick:stopPropagation>
            <div class="modal-header">
                <h2>Configuration Diff</h2>
                <button class="close-btn" @onclick="CloseDiffModal">&times;</button>
            </div>
            <div class="modal-body diff-viewer">
                <div class="diff-content">
                    @((MarkupString)diffContent)
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" @onclick="CloseDiffModal">Close</button>
            </div>
        </div>
    </div>
}

@code {
    private bool showConfigModal = false;
    private bool showDiffModal = false;
    private bool isEditMode = false;
    private Configuration currentConfig = new();
    private string diffContent = "";

    protected override async Task OnInitializedAsync()
    {
        await ViewModel.LoadConfigsAsync();
        await ViewModel.LoadVersionHistoryAsync();
    }

    private void ShowCreateConfigModal()
    {
        isEditMode = false;
        currentConfig = new Configuration();
        showConfigModal = true;
    }

    private async Task ShowEditConfigModal(Guid configId)
    {
        isEditMode = true;
        var config = ViewModel.ActiveConfigs.FirstOrDefault(c => c.Id == configId);
        if (config != null)
        {
            currentConfig = config;
            showConfigModal = true;
        }
    }

    private void CloseConfigModal()
    {
        showConfigModal = false;
    }

    private async Task SaveConfig()
    {
        if (isEditMode)
        {
            await ViewModel.UpdateConfigAsync(currentConfig);
        }
        else
        {
            await ViewModel.SaveConfigAsync(currentConfig);
        }
        showConfigModal = false;
        await ViewModel.LoadConfigsAsync();
    }

    private async Task ArchiveConfig(Guid configId)
    {
        await ViewModel.ArchiveConfigAsync(configId);
    }

    private async Task RestoreConfig(Guid configId)
    {
        await ViewModel.RestoreConfigAsync(configId);
    }

    private void SwitchTab(string tab)
    {
        ViewModel.ActiveTab = tab;
    }

    private async Task RefreshConfigurations()
    {
        await ViewModel.LoadConfigsAsync();
    }

    private void ViewDiff(Guid currentId, string previousId)
    {
        // TODO: Implement actual diff comparison
        diffContent = "<div class='diff-placeholder'>Diff comparison not yet implemented</div>";
        showDiffModal = true;
    }

    private void CloseDiffModal()
    {
        showDiffModal = false;
        diffContent = "";
    }

}

